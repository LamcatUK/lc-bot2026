{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lc-bot2026/faq",
	"title": "FAQ",
	"category": "lc-bot2026",
	"icon": "editor-help",
	"description": "Questions that open to show the answer. Also tells search engines it is a FAQ.",
	"attributes": {
		"brushTop": { "type": "boolean", "default": false },
		"spaceTop": { "type": "string", "default": "normal" },
		"spaceBottom": { "type": "string", "default": "normal" },
		"title": { "type": "string", "default": "Questions" },
		"items": { "type": "array", "default": [] },
		"surface": { "type": "string", "default": "surface" }
	},
	"supports": { "anchor": true, "className": true, "align": false },
	"editorScript": "file:./build/index.js",
	"render": "file:./render.php"
}
